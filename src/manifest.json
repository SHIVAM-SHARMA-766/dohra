{
  "manifest_version": 3,
  "name": "Dohra",
  "version": "0.0.0",
  "description": "Record a class or meeting in any browser tab — audio and video, saved on this computer only.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "tabCapture",
    "offscreen",
    "storage",
    "unlimitedStorage",
    "downloads",
    "nativeMessaging",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Dohra — record this tab",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "toggle-recording": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Start or stop recording the current tab"
    },
    "add-bookmark": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "Bookmark this moment in the recording"
    }
  }
}
